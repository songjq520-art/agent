# .env.example（环境变量示例文件）
# 只写变量名，不写真实密钥。复制成 .env 后再填入你自己的 Key。
# 注意：.env 文件不要传到 GitHub。

MODEL_API_KEY=
MUSE_API_KEY=
# 上面的 MUSE_API_KEY 是旧名，兼容用，两个都填时以 MODEL_API_KEY 为准
DEEPSEEK_API_KEY=
# 上面的 DEEPSEEK_API_KEY 是 DeepSeek 的 Key（第一任主控用），在 platform.deepseek.com 注册后填入
OPENAI_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
